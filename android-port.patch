@@ -0,0 +1,535 @@
+#if defined(__ANDROID__)
+
+#include "lwjgl/TouchControls.h"
+
+#include <cmath>
+#include <map>
+
+#include <glad/glad.h>
+
+#include "SDL.h"
+
+#include "lwjgl/Display.h"
+#include "lwjgl/Keyboard.h"
+#include "lwjgl/Mouse.h"
+
+namespace lwjgl
+{
+namespace TouchControls
+{
+namespace
+{
+
+// ---------------------------------------------------------------- layout
+
+enum Action
+{
+	ActJump,
+	ActAttack,
+	ActUse,
+	ActSneak,
+	ActInventory,
+	ActPause,
+	ActPrev,
+	ActNext,
+	ActDebug,
+	ActKeyboard,
+	ActCount
+};
+
+const char *const kLabels[ActCount] = { "JUMP", "HIT", "USE", "SNEAK", "INV", "ESC", "<", ">", "F3", "KB" };
+
+// Camera speed for dragging: pixels of finger travel -> mouse counts.
+const float kLookScale = 0.9f;
+
+struct Layout
+{
+	float u; // one tenth of the screen height
+	float cx[ActCount], cy[ActCount], r[ActCount];
+	float joyX, joyY, joyR;
+};
+
+Layout makeLayout()
+{
+	Layout L;
+	const float W = static_cast<float>(Display::getWidth());
+	const float H = static_cast<float>(Display::getHeight());
+	const float u = H * 0.1f;
+	L.u = u;
+	auto set = [&L](int a, float x, float y, float r)
+	{
+		L.cx[a] = x;
+		L.cy[a] = y;
+		L.r[a] = r;
+	};
+	set(ActJump, W - 2.0f * u, H - 2.2f * u, 1.25f * u);
+	set(ActAttack, W - 4.6f * u, H - 1.5f * u, 1.0f * u);
+	set(ActUse, W - 2.0f * u, H - 4.9f * u, 1.0f * u);
+	set(ActSneak, W - 4.8f * u, H - 3.9f * u, 1.0f * u);
+	set(ActInventory, W - 0.9f * u, 0.9f * u, 0.7f * u);
+	set(ActPause, 0.9f * u, 0.9f * u, 0.7f * u);
+	set(ActPrev, W * 0.5f - 4.6f * u, H - 0.9f * u, 0.6f * u);
+	set(ActNext, W * 0.5f + 4.6f * u, H - 0.9f * u, 0.6f * u);
+	set(ActDebug, 2.6f * u, 0.9f * u, 0.7f * u);
+	set(ActKeyboard, 4.3f * u, 0.9f * u, 0.7f * u);
+	L.joyX = 3.2f * u;
+	L.joyY = H - 3.2f * u;
+	L.joyR = 2.6f * u;
+	return L;
+}
+
+bool hitButton(const Layout &L, int a, float x, float y)
+{
+	const float dx = x - L.cx[a];
+	const float dy = y - L.cy[a];
+	const float r = L.r[a] * 1.15f;
+	return dx * dx + dy * dy <= r * r;
+}
+
+// ---------------------------------------------------------------- state
+
+struct Finger
+{
+	enum Kind
+	{
+		Button,
+		Joystick,
+		Look
+	};
+	Kind kind;
+	int index; // Action for buttons
+};
+
+std::map<SDL_FingerID, Finger> g_fingers;
+bool g_held[ActCount] = {};
+bool g_joyKey[4] = {}; // forward, left, back, right
+float g_thumbX = 0.0f;
+float g_thumbY = 0.0f;
+bool g_joyActive = false;
+float g_lookRemX = 0.0f;
+float g_lookRemY = 0.0f;
+
+const int kJoyKeys[4] = { Keyboard::KEY_W, Keyboard::KEY_A, Keyboard::KEY_S, Keyboard::KEY_D };
+
+void setActionState(int a, bool down)
+{
+	switch (a)
+	{
+		case ActJump:      Keyboard::detail::pushVirtualKey(Keyboard::KEY_SPACE, down); break;
+		case ActAttack:    Mouse::detail::pushVirtualButton(0, down); break;
+		case ActUse:       Mouse::detail::pushVirtualButton(1, down); break;
+		case ActInventory: Keyboard::detail::pushVirtualKey(Keyboard::KEY_E, down); break;
+		case ActPause:     Keyboard::detail::pushVirtualKey(Keyboard::KEY_ESCAPE, down); break;
+		case ActDebug:     Keyboard::detail::pushVirtualKey(Keyboard::KEY_F3, down); break;
+		default: break;
+	}
+	g_held[a] = down;
+}
+
+void pressButton(int a)
+{
+	if (a == ActSneak)
+	{
+		// Toggle: tap once to sneak, tap again to stop.
+		g_held[a] = !g_held[a];
+		Keyboard::detail::pushVirtualKey(Keyboard::KEY_LSHIFT, g_held[a]);
+	}
+	else if (a == ActKeyboard)
+	{
+		Keyboard::setTextInputActive(true);
+		g_held[a] = true;
+	}
+	else if (a == ActPrev)
+	{
+		Mouse::detail::pushVirtualWheel(1);
+		g_held[a] = true;
+	}
+	else if (a == ActNext)
+	{
+		Mouse::detail::pushVirtualWheel(-1);
+		g_held[a] = true;
+	}
+	else
+	{
+		setActionState(a, true);
+	}
+}
+
+void releaseButton(int a)
+{
+	if (a == ActSneak)
+		return;
+	if (a == ActPrev || a == ActNext || a == ActKeyboard)
+		g_held[a] = false;
+	else
+		setActionState(a, false);
+}
+
+void updateJoystick(const Layout &L, float x, float y)
+{
+	float dx = x - L.joyX;
+	float dy = y - L.joyY;
+	const float dead = L.joyR * 0.28f;
+	const bool want[4] = { dy < -dead, dx < -dead, dy > dead, dx > dead };
+	for (int i = 0; i < 4; i++)
+	{
+		if (want[i] != g_joyKey[i])
+		{
+			g_joyKey[i] = want[i];
+			Keyboard::detail::pushVirtualKey(kJoyKeys[i], want[i]);
+		}
+	}
+	const float len = std::sqrt(dx * dx + dy * dy);
+	const float maxLen = L.joyR * 0.75f;
+	if (len > maxLen)
+	{
+		dx *= maxLen / len;
+		dy *= maxLen / len;
+	}
+	g_thumbX = dx;
+	g_thumbY = dy;
+}
+
+void releaseJoystick()
+{
+	for (int i = 0; i < 4; i++)
+	{
+		if (g_joyKey[i])
+			Keyboard::detail::pushVirtualKey(kJoyKeys[i], false);
+		g_joyKey[i] = false;
+	}
+	g_joyActive = false;
+	g_thumbX = 0.0f;
+	g_thumbY = 0.0f;
+}
+
+void releaseAll()
+{
+	for (int a = 0; a < ActCount; a++)
+	{
+		if (!g_held[a])
+			continue;
+		if (a == ActSneak)
+		{
+			Keyboard::detail::pushVirtualKey(Keyboard::KEY_LSHIFT, false);
+			g_held[a] = false;
+		}
+		else
+		{
+			releaseButton(a);
+		}
+	}
+	releaseJoystick();
+	g_fingers.clear();
+	g_lookRemX = 0.0f;
+	g_lookRemY = 0.0f;
+}
+
+} // namespace
+
+// ---------------------------------------------------------------- events
+
+void handleFingerEvent(const SDL_Event &e)
+{
+	const float W = static_cast<float>(Display::getWidth());
+	const float H = static_cast<float>(Display::getHeight());
+	if (W <= 0.0f || H <= 0.0f)
+		return;
+
+	const SDL_FingerID id = e.tfinger.fingerId;
+	const float px = e.tfinger.x * W;
+	const float py = e.tfinger.y * H;
+	const bool playing = Mouse::isGrabbed();
+	const Layout L = makeLayout();
+
+	if (e.type == SDL_FINGERDOWN)
+	{
+		if (!playing)
+		{
+			// A menu is open: touches act as the mouse; only the ESC button is ours.
+			const int menuButtons[2] = { ActPause, ActKeyboard };
+			for (int a : menuButtons)
+			{
+				if (hitButton(L, a, px, py))
+				{
+					g_fingers[id] = { Finger::Button, a };
+					pressButton(a);
+					break;
+				}
+			}
+			return;
+		}
+		for (int a = 0; a < ActCount; a++)
+		{
+			if (hitButton(L, a, px, py))
+			{
+				g_fingers[id] = { Finger::Button, a };
+				pressButton(a);
+				return;
+			}
+		}
+		const float jx = px - L.joyX;
+		const float jy = py - L.joyY;
+		if (!g_joyActive && jx * jx + jy * jy <= L.joyR * L.joyR)
+		{
+			g_joyActive = true;
+			g_fingers[id] = { Finger::Joystick, 0 };
+			updateJoystick(L, px, py);
+			return;
+		}
+		g_fingers[id] = { Finger::Look, 0 };
+	}
+	else if (e.type == SDL_FINGERMOTION)
+	{
+		auto it = g_fingers.find(id);
+		if (it == g_fingers.end())
+			return;
+		if (it->second.kind == Finger::Joystick)
+		{
+			updateJoystick(L, px, py);
+		}
+		else if (it->second.kind == Finger::Look)
+		{
+			g_lookRemX += e.tfinger.dx * W * kLookScale;
+			g_lookRemY += e.tfinger.dy * H * kLookScale;
+			const int ix = static_cast<int>(g_lookRemX);
+			const int iy = static_cast<int>(g_lookRemY);
+			g_lookRemX -= static_cast<float>(ix);
+			g_lookRemY -= static_cast<float>(iy);
+			if (ix != 0 || iy != 0)
+				Mouse::detail::pushVirtualMotion(ix, iy);
+		}
+	}
+	else if (e.type == SDL_FINGERUP)
+	{
+		auto it = g_fingers.find(id);
+		if (it == g_fingers.end())
+			return;
+		if (it->second.kind == Finger::Button)
+			releaseButton(it->second.index);
+		else if (it->second.kind == Finger::Joystick)
+			releaseJoystick();
+		g_fingers.erase(it);
+	}
+}
+
+void onGrabChanged(bool grabbed)
+{
+	releaseAll();
+	// While playing, touches must not also turn into mouse clicks and motion.
+	SDL_SetHint(SDL_HINT_TOUCH_MOUSE_EVENTS, grabbed ? "0" : "1");
+}
+
+// ---------------------------------------------------------------- drawing
+
+namespace
+{
+
+struct Glyph
+{
+	char c;
+	unsigned char rows[7];
+};
+
+const Glyph kGlyphs[] = {
+	{ 'A', { 0x0E, 0x11, 0x11, 0x1F, 0x11, 0x11, 0x11 } },
+	{ 'B', { 0x1E, 0x11, 0x11, 0x1E, 0x11, 0x11, 0x1E } },
+	{ 'C', { 0x0E, 0x11, 0x10, 0x10, 0x10, 0x11, 0x0E } },
+	{ 'E', { 0x1F, 0x10, 0x10, 0x1E, 0x10, 0x10, 0x1F } },
+	{ 'F', { 0x1F, 0x10, 0x10, 0x1E, 0x10, 0x10, 0x10 } },
+	{ '3', { 0x0E, 0x11, 0x01, 0x06, 0x01, 0x11, 0x0E } },
+	{ 'H', { 0x11, 0x11, 0x11, 0x1F, 0x11, 0x11, 0x11 } },
+	{ 'I', { 0x0E, 0x04, 0x04, 0x04, 0x04, 0x04, 0x0E } },
+	{ 'J', { 0x07, 0x02, 0x02, 0x02, 0x02, 0x12, 0x0C } },
+	{ 'K', { 0x11, 0x12, 0x14, 0x18, 0x14, 0x12, 0x11 } },
+	{ 'M', { 0x11, 0x1B, 0x15, 0x15, 0x11, 0x11, 0x11 } },
+	{ 'N', { 0x11, 0x19, 0x15, 0x13, 0x11, 0x11, 0x11 } },
+	{ 'P', { 0x1E, 0x11, 0x11, 0x1E, 0x10, 0x10, 0x10 } },
+	{ 'S', { 0x0F, 0x10, 0x10, 0x0E, 0x01, 0x01, 0x1E } },
+	{ 'T', { 0x1F, 0x04, 0x04, 0x04, 0x04, 0x04, 0x04 } },
+	{ 'U', { 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0E } },
+	{ 'V', { 0x11, 0x11, 0x11, 0x11, 0x11, 0x0A, 0x04 } },
+	{ '<', { 0x02, 0x04, 0x08, 0x10, 0x08, 0x04, 0x02 } },
+	{ '>', { 0x08, 0x04, 0x02, 0x01, 0x02, 0x04, 0x08 } },
+};
+
+const Glyph *findGlyph(char c)
+{
+	for (const Glyph &g : kGlyphs)
+		if (g.c == c)
+			return &g;
+	return nullptr;
+}
+
+void fillCircle(float cx, float cy, float r)
+{
+	const int segments = 28;
+	glBegin(GL_TRIANGLES);
+	for (int i = 0; i < segments; i++)
+	{
+		const float a0 = 6.2831853f * static_cast<float>(i) / segments;
+		const float a1 = 6.2831853f * static_cast<float>(i + 1) / segments;
+		glVertex2f(cx, cy);
+		glVertex2f(cx + std::cos(a0) * r, cy + std::sin(a0) * r);
+		glVertex2f(cx + std::cos(a1) * r, cy + std::sin(a1) * r);
+	}
+	glEnd();
+}
+
+void ring(float cx, float cy, float r, float thickness)
+{
+	const int segments = 28;
+	const float inner = r - thickness;
+	glBegin(GL_QUADS);
+	for (int i = 0; i < segments; i++)
+	{
+		const float a0 = 6.2831853f * static_cast<float>(i) / segments;
+		const float a1 = 6.2831853f * static_cast<float>(i + 1) / segments;
+		glVertex2f(cx + std::cos(a0) * r, cy + std::sin(a0) * r);
+		glVertex2f(cx + std::cos(a1) * r, cy + std::sin(a1) * r);
+		glVertex2f(cx + std::cos(a1) * inner, cy + std::sin(a1) * inner);
+		glVertex2f(cx + std::cos(a0) * inner, cy + std::sin(a0) * inner);
+	}
+	glEnd();
+}
+
+void triangle(float x1, float y1, float x2, float y2, float x3, float y3)
+{
+	glBegin(GL_TRIANGLES);
+	glVertex2f(x1, y1);
+	glVertex2f(x2, y2);
+	glVertex2f(x3, y3);
+	glEnd();
+}
+
+void drawLabel(const char *label, float cx, float cy, float r)
+{
+	int n = 0;
+	while (label[n])
+		n++;
+	const int cellsWide = n * 5 + (n - 1);
+	const float byWidth = (r * 1.5f) / static_cast<float>(cellsWide);
+	const float byHeight = (r * 0.9f) / 7.0f;
+	float cell = std::floor(byWidth < byHeight ? byWidth : byHeight);
+	if (cell < 2.0f)
+		cell = 2.0f;
+	const float x0 = cx - cell * static_cast<float>(cellsWide) * 0.5f;
+	const float y0 = cy - cell * 3.5f;
+	glBegin(GL_QUADS);
+	for (int i = 0; i < n; i++)
+	{
+		const Glyph *g = findGlyph(label[i]);
+		if (!g)
+			continue;
+		const float gx = x0 + cell * static_cast<float>(i * 6);
+		for (int row = 0; row < 7; row++)
+		{
+			for (int col = 0; col < 5; col++)
+			{
+				if (!(g->rows[row] & (0x10 >> col)))
+					continue;
+				const float x = gx + cell * static_cast<float>(col);
+				const float y = y0 + cell * static_cast<float>(row);
+				glVertex2f(x, y);
+				glVertex2f(x + cell, y);
+				glVertex2f(x + cell, y + cell);
+				glVertex2f(x, y + cell);
+			}
+		}
+	}
+	glEnd();
+}
+
+void drawButton(const Layout &L, int a)
+{
+	const float cx = L.cx[a];
+	const float cy = L.cy[a];
+	const float r = L.r[a];
+	if (g_held[a])
+		glColor4f(1.0f, 1.0f, 1.0f, 0.40f);
+	else
+		glColor4f(0.0f, 0.0f, 0.0f, 0.35f);
+	fillCircle(cx, cy, r);
+	glColor4f(1.0f, 1.0f, 1.0f, 0.55f);
+	ring(cx, cy, r, r * 0.06f);
+	glColor4f(1.0f, 1.0f, 1.0f, 0.90f);
+	drawLabel(kLabels[a], cx, cy, r);
+}
+
+void drawJoystick(const Layout &L)
+{
+	glColor4f(0.0f, 0.0f, 0.0f, 0.22f);
+	fillCircle(L.joyX, L.joyY, L.joyR);
+	glColor4f(1.0f, 1.0f, 1.0f, 0.40f);
+	ring(L.joyX, L.joyY, L.joyR, L.joyR * 0.03f);
+
+	// Direction arrows.
+	const float s = L.u * 0.35f;
+	const float d = L.joyR * 0.72f;
+	glColor4f(1.0f, 1.0f, 1.0f, g_joyKey[0] ? 0.9f : 0.45f);
+	triangle(L.joyX, L.joyY - d - s, L.joyX - s, L.joyY - d + s, L.joyX + s, L.joyY - d + s);
+	glColor4f(1.0f, 1.0f, 1.0f, g_joyKey[2] ? 0.9f : 0.45f);
+	triangle(L.joyX, L.joyY + d + s, L.joyX - s, L.joyY + d - s, L.joyX + s, L.joyY + d - s);
+	glColor4f(1.0f, 1.0f, 1.0f, g_joyKey[1] ? 0.9f : 0.45f);
+	triangle(L.joyX - d - s, L.joyY, L.joyX - d + s, L.joyY - s, L.joyX - d + s, L.joyY + s);
+	glColor4f(1.0f, 1.0f, 1.0f, g_joyKey[3] ? 0.9f : 0.45f);
+	triangle(L.joyX + d + s, L.joyY, L.joyX + d - s, L.joyY - s, L.joyX + d - s, L.joyY + s);
+
+	// Thumb.
+	glColor4f(1.0f, 1.0f, 1.0f, g_joyActive ? 0.40f : 0.22f);
+	fillCircle(L.joyX + g_thumbX, L.joyY + g_thumbY, L.u * 0.9f);
+}
+
+} // namespace
+
+void draw()
+{
+	const int W = Display::getWidth();
+	const int H = Display::getHeight();
+	if (W <= 0 || H <= 0)
+		return;
+	const bool playing = Mouse::isGrabbed();
+	const Layout L = makeLayout();
+
+	glPushAttrib(GL_ALL_ATTRIB_BITS);
+	glViewport(0, 0, W, H);
+	glMatrixMode(GL_PROJECTION);
+	glPushMatrix();
+	glLoadIdentity();
+	glOrtho(0.0, static_cast<double>(W), static_cast<double>(H), 0.0, -1.0, 1.0);
+	glMatrixMode(GL_MODELVIEW);
+	glPushMatrix();
+	glLoadIdentity();
+
+	glDisable(GL_TEXTURE_2D);
+	glDisable(GL_LIGHTING);
+	glDisable(GL_FOG);
+	glDisable(GL_DEPTH_TEST);
+	glDisable(GL_ALPHA_TEST);
+	glDisable(GL_CULL_FACE);
+	glEnable(GL_BLEND);
+	glBlendFunc(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA);
+
+	if (playing)
+	{
+		drawJoystick(L);
+		for (int a = 0; a < ActCount; a++)
+			drawButton(L, a);
+	}
+	else
+	{
+		drawButton(L, ActPause);
+		drawButton(L, ActKeyboard);
+	}
+
+	glMatrixMode(GL_PROJECTION);
+	glPopMatrix();
+	glMatrixMode(GL_MODELVIEW);
+	glPopMatrix();
+	glPopAttrib();
+}
+
+}
+}
+
+#endif
