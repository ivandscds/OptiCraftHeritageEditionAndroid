+
+struct AndroidBacktrace
+{
+	void **current;
+	void **end;
+};
+
+_Unwind_Reason_Code androidUnwindCallback(struct _Unwind_Context *context, void *arg)
+{
+	AndroidBacktrace *state = static_cast<AndroidBacktrace *>(arg);
+	const uintptr_t pc = _Unwind_GetIP(context);
+	if (pc)
+	{
+		if (state->current == state->end)
+			return _URC_END_OF_STACK;
+		*state->current++ = reinterpret_cast<void *>(pc);
+	}
+	return _URC_NO_REASON;
+}
+
+// Best effort (not async-signal-safe, but the process is dying anyway): one line per frame,
+// "library+offset  function". Function names come from the dynamic symbol table.
+// Logs the app's resident memory and how much the system has free, so a run that ends
+// without a crash marker (killed by Android for using too much memory, or hanging) can be
+// told apart from an actual signal: check the last of these lines before the log stops.
+} // end anonymous namespace (external linkage needed: declared in platform/Log.h, called from other translation units)
+
+namespace
+{
+std::mutex g_checkpointLock;
+char g_checkpoint[256] = "(none yet)";
+std::atomic<long> g_checkpointCount{0};
+
+void androidWatchdogRun()
+{
+	long lastCount = -1;
+	int sameCountTicks = 0;
+	while (true)
+	{
+		std::this_thread::sleep_for(std::chrono::seconds(1));
+		char copy[256];
+		{
+			std::lock_guard<std::mutex> guard(g_checkpointLock);
+			std::memcpy(copy, g_checkpoint, sizeof(copy));
+		}
+		const long count = g_checkpointCount.load();
+		// Once the checkpoint stops changing, the game is either idle at a menu (fine) or
+		// stuck: repeat less often so an idle session doesn't spam the log for hours.
+		if (count == lastCount)
+		{
+			if (++sameCountTicks % 15 != 1)
+				continue;
+		}
+		else
+		{
+			sameCountTicks = 0;
+		}
+		lastCount = count;
+		std::fprintf(stderr, "[watchdog] last known: %s\n", copy);
+	}
+}
+}
+
+void androidSetCheckpoint(const char *format, ...)
+{
+	char buffer[256];
+	va_list args;
+	va_start(args, format);
+	std::vsnprintf(buffer, sizeof(buffer), format, args);
+	va_end(args);
+	std::lock_guard<std::mutex> guard(g_checkpointLock);
+	std::memcpy(g_checkpoint, buffer, sizeof(buffer));
+	g_checkpointCount.fetch_add(1, std::memory_order_relaxed);
+}
+
+void androidLogMemory(const char *label)
+{
+	long rssKb = -1;
+	if (FILE *f = std::fopen("/proc/self/status", "r"))
+	{
+		char line[256];
+		while (std::fgets(line, sizeof(line), f))
+		{
+			if (std::sscanf(line, "VmRSS: %ld kB", &rssKb) == 1)
+				break;
+		}
+		std::fclose(f);
+	}
+	long availKb = -1;
+	if (FILE *f = std::fopen("/proc/meminfo", "r"))
+	{
+		char line[256];
+		while (std::fgets(line, sizeof(line), f))
+		{
+			if (std::sscanf(line, "MemAvailable: %ld kB", &availKb) == 1)
+				break;
+		}
+		std::fclose(f);
+	}
+	std::fprintf(stderr, "[mem] %s: app RSS=%ld KB, system available=%ld KB\n", label, rssKb, availKb);
+}
