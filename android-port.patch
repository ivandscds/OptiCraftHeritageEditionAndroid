+}
+
+// Lets gl4es options be tried without rebuilding: /sdcard/OptiCraft/gl4es.env (plain text,
+// one NAME=VALUE per line, only LIBGL_* names, '#' starts a comment).
+void androidApplyGlEnvFile()
+{
+	const char *candidates[] = { "/sdcard/OptiCraft/gl4es.env", "/storage/emulated/0/OptiCraft/gl4es.env" };
+	for (const char *file : candidates)
+	{
+		std::ifstream in(file);
+		if (!in)
+			continue;
+		std::string line;
+		while (std::getline(in, line))
+		{
+			while (!line.empty() && (line.back() == '\r' || line.back() == ' ' || line.back() == '\t'))
+				line.pop_back();
+			if (line.empty() || line[0] == '#')
+				continue;
+			const size_t eq = line.find('=');
+			if (eq == std::string::npos)
+				continue;
+			const std::string name = line.substr(0, eq);
+			const std::string value = line.substr(eq + 1);
+			if (name.compare(0, 6, "LIBGL_") != 0)
+				continue;
+			setenv(name.c_str(), value.c_str(), 1);
+			std::fprintf(stderr, "[gl4es.env] %s=%s\n", name.c_str(), value.c_str());
+		}
+		return;
+	}
+}
+
+void androidStartDiagnostics()
+{
+	// Landscape only (both directions). Without this the resizable window lets SDL pick
+	// "all orientations", which overrides the manifest.
+	SDL_SetHint(SDL_HINT_ORIENTATIONS, "LandscapeLeft LandscapeRight");
+	const char *internalDir = SDL_AndroidGetInternalStoragePath();
+	if (!internalDir)
+		return;
+
+	// Prefer /sdcard/OptiCraft so the log can be read from a file manager right after a run;
+	// use the app's own storage when "all files access" was not granted.
+	std::string logDir = internalDir;
+	if (access("/sdcard/OptiCraft", W_OK) == 0)
+		logDir = "/sdcard/OptiCraft";
+	const std::string path = logDir + "/last_run.log";
+	const std::string previousPath = logDir + "/previous_run.log";
+
+	const std::string fullPrevious = androidReadTail(path, 1 << 20);
+	if (!fullPrevious.empty())
+	{
+		// Keep the last run readable as previous_run.log (no dialog is shown any more).
+		std::rename(path.c_str(), previousPath.c_str());
+	}
+	// gl4es: print the shader source and the real compiler error when a shader fails.
+	setenv("LIBGL_LOGSHADERERROR", "1", 1);
+	// The diagonal-split, wrongly-shaded blocks/hand this was working around turned out to be
+	// Tessellator not copying a vertex's normal when it duplicated that vertex to split a quad
+	// into two triangles (fixed there): the two duplicated vertices carried a (0,0,0) normal,
+	// forcing a real per-vertex re-normalize. Every block face normal here is already unit
+	// length, so with that fixed there is nothing left to normalize away, and forcing it back
+	// on would only add a redundant normalize() per vertex in gl4es's shader for no benefit.
+
+	g_androidLogFd = open(path.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0644);
+	if (g_androidLogFd < 0)
+		return;
+	dup2(g_androidLogFd, 1);
+	dup2(g_androidLogFd, 2);
+	std::setvbuf(stdout, nullptr, _IONBF, 0);
+	std::setvbuf(stderr, nullptr, _IONBF, 0);
+	SDL_LogSetOutputFunction(androidLogOutput, nullptr);
+	// Run the handlers on their own stack: a stack-overflow SIGSEGV has no room left on the
+	// thread's own stack to even start the handler, and would otherwise die silently with
+	// nothing written to the log.
+	static std::vector<char> altStack(1 << 20); // 1 MB: our own handler (backtrace, demangling) needs real room
+	stack_t ss = {};
+	ss.ss_sp = altStack.data();
+	ss.ss_size = altStack.size();
+	sigaltstack(&ss, nullptr);
+	for (int sig : { SIGSEGV, SIGABRT, SIGBUS, SIGFPE, SIGILL })
+	{
+		struct sigaction action = {};
+		action.sa_handler = androidSignalHandler;
+		action.sa_flags = SA_ONSTACK;
+		sigemptyset(&action.sa_mask);
+		sigaction(sig, &action, nullptr);
+	}
+	std::fprintf(stderr, "[boot] log started\n");
+	androidApplyGlEnvFile();
+	std::thread(androidWatchdogRun).detach();
+}
