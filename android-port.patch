+#if defined(__ANDROID__)
+// Android has no console, so a failed start looks like the app simply closing.
+// Everything the game prints goes to last_run.log; if the previous run did not
+// end with the clean-exit marker, its tail is shown in a dialog on the next start.
+int g_androidLogFd = -1;
+const char kCleanExitMarker[] = "--- clean exit ---";
+
+struct AndroidBacktrace
+{
+	void **current;
+	void **end;
+};
+
+_Unwind_Reason_Code androidUnwindCallback(struct _Unwind_Context *context, void *arg)
+{
+	AndroidBacktrace *state = static_cast<AndroidBacktrace *>(arg);
+	const uintptr_t pc = _Unwind_GetIP(context);
+	if (pc)
+	{
+		if (state->current == state->end)
+			return _URC_END_OF_STACK;
+		*state->current++ = reinterpret_cast<void *>(pc);
+	}
+	return _URC_NO_REASON;
+}
+
+// Best effort (not async-signal-safe, but the process is dying anyway): one line per frame,
+// "library+offset  function". Function names come from the dynamic symbol table.
+void androidWriteBacktrace(int fd)
+{
+	void *frames[40];
+	AndroidBacktrace state = { frames, frames + 40 };
+	_Unwind_Backtrace(androidUnwindCallback, &state);
+	const int count = static_cast<int>(state.current - frames);
+	for (int i = 0; i < count; i++)
+	{
+		Dl_info info;
+		if (dladdr(frames[i], &info) && info.dli_fbase)
+		{
+			const char *lib = info.dli_fname ? std::strrchr(info.dli_fname, '/') : nullptr;
+			lib = lib ? lib + 1 : (info.dli_fname ? info.dli_fname : "?");
+			int status = 0;
+			char *demangled = info.dli_sname ? abi::__cxa_demangle(info.dli_sname, nullptr, nullptr, &status) : nullptr;
+			dprintf(fd, "  #%02d %s+0x%lx  %s\n", i, lib,
+			        static_cast<unsigned long>(reinterpret_cast<uintptr_t>(frames[i]) - reinterpret_cast<uintptr_t>(info.dli_fbase)),
+			        demangled ? demangled : (info.dli_sname ? info.dli_sname : "?"));
+			std::free(demangled);
+		}
+		else
+		{
+			dprintf(fd, "  #%02d %p\n", i, frames[i]);
+		}
+	}
+}
+
+void androidSignalHandler(int sig)
+{
+	const char *name = sig == SIGSEGV ? "SIGSEGV" : sig == SIGABRT ? "SIGABRT" : sig == SIGBUS ? "SIGBUS" : sig == SIGFPE ? "SIGFPE" : sig == SIGILL ? "SIGILL" : "signal";
+	char buf[80];
+	const int n = std::snprintf(buf, sizeof(buf), "\n*** CRASH: %s (%d)\n", name, sig);
+	if (g_androidLogFd >= 0 && n > 0)
+	{
+		const ssize_t ignored = write(g_androidLogFd, buf, static_cast<size_t>(n));
+		(void)ignored;
+		androidWriteBacktrace(g_androidLogFd);
+	}
+	std::signal(sig, SIG_DFL);
+	std::raise(sig);
+}
+
+std::string androidReadTail(const std::string &path, size_t maxBytes)
+{
+	std::ifstream in(path, std::ios::binary | std::ios::ate);
+	if (!in)
+		return std::string();
+	const std::streamoff size = in.tellg();
+	const std::streamoff start = size > static_cast<std::streamoff>(maxBytes) ? size - static_cast<std::streamoff>(maxBytes) : 0;
+	in.seekg(start);
+	std::string out(static_cast<size_t>(size - start), '\0');
+	in.read(&out[0], static_cast<std::streamsize>(out.size()));
+	return out;
+}
+
+void androidLogOutput(void *, int, SDL_LogPriority, const char *message)
+{
+	std::fprintf(stderr, "[SDL] %s\n", message);
+}
+
+void androidStartDiagnostics()
+{
+	const char *dir = SDL_AndroidGetInternalStoragePath();
+	if (!dir)
+		return;
+	const std::string path = std::string(dir) + "/last_run.log";
+
+	const std::string fullPrevious = androidReadTail(path, 1 << 20);
+	const std::string previous = fullPrevious.size() > 12000 ? fullPrevious.substr(fullPrevious.size() - 12000) : fullPrevious;
+	if (!previous.empty() && previous.find(kCleanExitMarker) == std::string::npos)
+	{
+		// The dialog cannot scroll or copy on every device, so it only shows the last
+		// few lines; the longer tail goes to the clipboard and to last_crash.log.
+		std::string shortTail = previous.size() > 700 ? previous.substr(previous.size() - 700) : previous;
+		const size_t firstNewline = shortTail.find('\n');
+		if (previous.size() > 700 && firstNewline != std::string::npos)
+			shortTail.erase(0, firstNewline + 1);
+
+		SDL_Init(SDL_INIT_VIDEO); // the clipboard needs the video subsystem
+		SDL_SetClipboardText(previous.c_str());
+		for (const std::string &copy : { std::string(dir) + "/last_crash.log", std::string("/sdcard/OptiCraft/last_crash.log") })
+		{
+			std::ofstream out(copy, std::ios::binary | std::ios::trunc);
+			if (out)
+				out << fullPrevious;
+		}
+		const std::string message = "El log quedo copiado al portapapeles: pegalo en el chat.\n\n..." + shortTail;
+		SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, "OptiCraft: la ejecucion anterior termino mal", message.c_str(), nullptr);
+	}
+
+	// gl4es: print the shader source and the real compiler error when a shader fails.
+	setenv("LIBGL_LOGSHADERERROR", "1", 1);
+
+	g_androidLogFd = open(path.c_str(), O_WRONLY | O_CREAT | O_TRUNC, 0644);
+	if (g_androidLogFd < 0)
+		return;
+	dup2(g_androidLogFd, 1);
+	dup2(g_androidLogFd, 2);
+	std::setvbuf(stdout, nullptr, _IONBF, 0);
+	std::setvbuf(stderr, nullptr, _IONBF, 0);
+	SDL_LogSetOutputFunction(androidLogOutput, nullptr);
+	for (int sig : { SIGSEGV, SIGABRT, SIGBUS, SIGFPE, SIGILL })
+		std::signal(sig, androidSignalHandler);
+	std::fprintf(stderr, "[boot] log started\n");
+}
+
+bool androidHasGameData()
+{
+	const std::filesystem::path base(PlatformResources::baseDir());
+	std::error_code ec;
+	if (std::filesystem::exists(base / "assets.pak", ec) || std::filesystem::exists(base / "assets", ec))
+		return true;
+	const std::string message =
+		"No encuentro los assets del juego.\n\nBusque en: " + base.string() +
+		"\n\nCopia las carpetas 'assets' y 'resources' (o 'assets.pak') a /sdcard/OptiCraft/ "
+		"y dale el permiso de acceso a todos los archivos, o copialas a la carpeta Android/data/org.opticraft.heritage/files/.";
+	SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, "OptiCraft", message.c_str(), nullptr);
+	std::fprintf(stderr, "[boot] no game data in %s\n%s\n", base.string().c_str(), kCleanExitMarker);
+	return false;
+}
